# API Configuration
# Gateway (infra/nginx/nginx.conf) — a single reverse-proxy in front of
# every backend service, no "/api" prefix on individual routes.
VITE_API_URL=http://localhost

# Feature Flags
VITE_ENABLE_MFA=true

# App Configuration
VITE_APP_NAME=Ambassade du Mali
VITE_APP_VERSION=1.0.0
